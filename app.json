{
  "expo": {
    "name": "Mole Tracker",
    "slug": "mole-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "mole-tracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false
    },
    "android": {},
    "web": {
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
